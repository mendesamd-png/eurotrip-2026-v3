---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../data/url';
import { episodes } from '../data/podcast';
import sources from '../data/podcast-sources.json';
import { images, unsplash } from '../data/images';
import '../styles/editorial.css';
import '../styles/podcast.css';
const audioUrl = (audio: string | null) => audio ? (/^https:\/\//.test(audio) ? audio : u(audio)) : null;
const available = episodes.filter(e => e.audio).length;
const englishAvailable = episodes.filter(e => e.english?.audio).length;
const items = episodes.map(e => ({...e, audio: audioUrl(e.audio), img: images[e.image], sources: e.sourceIds.map(id => sources[id as keyof typeof sources]), versions: [{language:'pt', label:'Português', title:e.title, audio:audioUrl(e.audio), duration:e.duration}, ...(e.english ? [{language:'en',label:'English',title:e.english.title,audio:audioUrl(e.english.audio),duration:e.english.duration}] : [])]}));
---
<BaseLayout title="Podcast da viagem" description="Uma playlist para descobrir cada lugar da Eurotrip: histórias, futebol, arte e o nosso roteiro em áudio." current={u('/podcast')}>
 <header class="wrap editorial-intro podcast-intro"><p class="tc">Perto, mesmo longe · podcast da viagem</p><h1 class="t-hero">Cada lugar,<br/>uma conversa.</h1><p class="t-lead">Para conhecer antes de chegar. Para ouvir no caminho. Ou para viajar com a gente sem sair de casa. Uma playlist de histórias que encontram o nosso roteiro.</p><p class="playlist-summary tc">{episodes.length} episódios · {available ? `${available} para ouvir` : 'áudios em preparação'}{englishAvailable > 0 && ` · ${englishAvailable} também em inglês`}</p><div class="podcast-intro-actions">{available > 0 && <a class="btn podcast-listen-link" href="#podcast-playlist">Ouvir os episódios ↓</a>}{englishAvailable > 0 && <a class="btn podcast-listen-link" href={u('/podcast/?lang=en#podcast-playlist')}>Praticar em inglês ↗</a>}</div></header>
 <div class="wrap podcast-layout" id="podcast-playlist">
  <nav class="playlist" aria-label="Episódios do podcast"><p class="tc playlist-label">Escolha a próxima parada</p><ol>{episodes.map(e => <li><a class="episode-select" href={`#${e.slug}`} data-episode={e.slug}><span class="episode-index tc">{e.number}</span><span><span class="episode-city">{e.city}</span><span class="episode-name">{e.title}</span><span class="episode-state tc" data-duration-pt={e.duration} data-duration-en={e.english?.duration}>{e.audio ? `▶ Ouvir · ${e.duration || ''}` : 'Em preparação'}</span></span><span class="episode-arrow" aria-hidden="true">↗</span></a></li>)}</ol></nav>
  <div class="episode-panels">
   <p id="playlist-announcement" class="sr-only" role="status" aria-live="polite"></p>
   {items.map((e,i) => (<article class="episode-panel" id={e.slug} data-panel={e.slug} aria-labelledby={`title-${e.slug}`}>
    <figure class="podcast-cover"><img src={unsplash(e.img,1200,80)} alt={e.img.alt} loading={i===0?'eager':'lazy'} width="1200" height="800"/><div class="cover-shade"></div><figcaption><span class="tc">EP {e.number} / {e.country}</span><span class="cover-city">{e.city}</span><a href={u('/colophon')} class="cover-credit">Imagem de referência · créditos ↗</a></figcaption></figure>
    <div class="podcast-body"><p class="editorial-status">{e.audio ? 'Disponível para ouvir' : 'Episódio em preparação'}</p><h2 class="t-xl" id={`title-${e.slug}`} tabindex="-1">{e.title}</h2>
     {e.english && <div class="audio-languages" role="group" aria-label="Idioma do podcast" hidden><button type="button" data-language="pt" aria-pressed="true">Português</button><button type="button" data-language="en" aria-pressed="false" lang="en">English</button></div>}
     {e.versions.map(v => v.audio ? <div class="episode-audio" data-audio-language={v.language}>
      <p class="audio-edition tc">{v.label}{v.language==='en' && <span lang="en"> · {v.title}</span>}</p>
      <div class="audio-heading"><button type="button" class="btn audio-toggle" hidden aria-controls={`audio-${e.slug}-${v.language}`} aria-label={`Ouvir ${v.title}`}>▶ Ouvir episódio</button><span class="tc audio-duration">{v.duration}</span></div>
      <audio id={`audio-${e.slug}-${v.language}`} controls preload="none" src={v.audio} data-title={v.title} lang={v.language==='en'?'en':'pt-BR'} aria-label={`Áudio em ${v.label}: ${v.title}`}>Ouça ou baixe o arquivo pelo link: <a href={v.audio}>Baixar episódio</a>.</audio>
      <div class="audio-options"><label class="audio-speed" hidden>Velocidade <select aria-label={`Velocidade de ${v.title}`}><option value="0.75">0,75×</option><option value="1" selected>1×</option><option value="1.25">1,25×</option><option value="1.5">1,5×</option><option value="2">2×</option></select></label><a href={v.audio} download>Baixar {v.label} ↓</a></div>
      {v.language==='en' && <p class="editorial-source">Para praticar: ouça uma vez pelo contexto, volte aos trechos favoritos e tente responder em voz alta. Se quiser, diminua a velocidade.</p>}
      <p class="editorial-source">Conversa gerada com IA no NotebookLM a partir de fontes da viagem. Ouça com olhar curioso; as informações podem mudar.</p><p class="audio-error" role="status" hidden>O áudio encontrou uma dificuldade para carregar. Tente novamente ou use o link para baixar.</p>
     </div> : <div class="episode-pending"><span aria-hidden="true">◌</span><div><strong>Esta conversa está ganhando voz.</strong><p>O áudio chega depois da preparação e revisão. Por enquanto, descubra o que vamos contar.</p></div></div>)}
     <p class="episode-description">{e.description}</p><p class="episode-when tc">{e.when}</p>
     <section class="episode-section"><h3 class="tc">Lugares que entram na conversa</h3><ul class="episode-stops">{e.stops.map(s=><li>{s}</li>)}</ul></section>
     <section class="episode-section"><h3 class="t-m">O fio da história</h3><ol class="episode-topics">{e.topics.map(t=><li>{t}</li>)}</ol></section>
     <p class="episode-note">{e.note}</p>
     <details class="episode-sources"><summary>Fontes para conhecer mais</summary><ul>{e.sources.map(s => (<li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.recurso} ↗</a></li>))}</ul><p class="editorial-source">Pesquisa de 15/09/2026. No especial do jogo, o panorama esportivo será atualizado perto da partida.</p></details>
     {e.transcript.length>0 && <details class="episode-sources"><summary>Ler a transcrição</summary><div class="prose">{e.transcript.map(p=><p>{p}</p>)}</div></details>}
     <a class="lnk chapter-link" href={u(`/capitulo/${e.chapter}`)}>Abrir o roteiro deste destino ↗</a>
     <nav class="episode-navigation" aria-label={`Navegar a partir do episódio ${e.number}`}>{i>0 && <a href={`#${episodes[i-1].slug}`} data-episode={episodes[i-1].slug}>← Anterior</a>}{i < episodes.length - 1 && <a class="next-episode" href={`#${episodes[i+1].slug}`} data-episode={episodes[i+1].slug}>Próximo episódio →</a>}</nav>
    </div>
   </article>))}
  </div>
 </div>
 <aside class="wrap editorial-callout"><p class="tc">Uma viagem que também se ouve</p><h2 class="t-l">A rua dá o assunto.<br/>A gente puxa a conversa.</h2><p class="t-lead">Cada episódio liga a história do lugar ao que queremos viver ali. O especial de Old Trafford ganha uma atualização na semana do jogo; a Madeira pede tempo para escutar a paisagem.</p><div class="editorial-links"><a class="btn" href={u('/futebol')}>Futebol & Ted Lasso ↗</a><a class="btn" href={u('/trabalhos')}>Os dois trabalhos ↗</a><a class="lnk" href={u('/diario')}>Ler o diário ↗</a></div></aside>
</BaseLayout>
<script>
 import '../scripts/podcast';
</script>
