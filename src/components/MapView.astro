---
/** Mapa escuro (ou off-white). Leaflet + OSM com tiles filtrados via CSS.
 *  Movimento: rota desenhada em sequência, viajante que percorre a rota, pinos pulsando,
 *  atalhos que voam até cada parada, sincronia com elementos externos via data-map-focus. */
export type Marker = { name: string; lat: number; lng: number; blurb?: string; kind?: 'base' | 'trabalho' | 'lugar' | 'rota'; href?: string; label?: string; chapter?: string; slug?: string };
interface Props {
  id: string;
  markers: Marker[];
  route?: { lat: number; lng: number; name?: string; chapter?: string }[];
  center: { lat: number; lng: number; zoom: number };
  fit?: boolean;
  animate?: boolean;
  /** atalhos que voam até cada ponto da rota */
  stops?: { label: string; lat: number; lng: number; zoom?: number; slug?: string }[];
}
const { id, markers, route = [], center, fit = false, animate = false, stops = [] } = Astro.props;
---

<div class="map" id={id} data-markers={JSON.stringify(markers)} data-route={JSON.stringify(route)} data-center={JSON.stringify(center)} data-fit={String(fit)} data-animate={String(animate)} role="region" aria-label="Mapa interativo">
  <div class="map-hud" data-hud></div>
  {(route.length > 1 || stops.length > 0) && (
    <div class="map-ui">
      {route.length > 1 && <button class="btn" data-play type="button">▶ percorrer a rota</button>}
      {stops.map((s) => (<button class="btn" type="button" data-stop data-lat={s.lat} data-lng={s.lng} data-zoom={s.zoom ?? 11} data-slug={s.slug}>{s.label}</button>))}
      {(fit || stops.length > 0) && <button class="btn" data-reset type="button">↺ tudo</button>}
    </div>
  )}
</div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  const mapsUrl = (q: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cssVar = (n: string) => getComputedStyle(document.body).getPropertyValue(n).trim();

  document.querySelectorAll<HTMLElement>('.map[data-markers]').forEach((el) => {
    const markers = JSON.parse(el.dataset.markers || '[]');
    const route = JSON.parse(el.dataset.route || '[]');
    const center = JSON.parse(el.dataset.center || '{}');
    const fit = el.dataset.fit === 'true';
    const animate = el.dataset.animate === 'true';
    const hud = el.querySelector<HTMLElement>('[data-hud]');

    const map = L.map(el, { scrollWheelZoom: false, zoomControl: true, zoomAnimation: true }).setView([center.lat, center.lng], center.zoom);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors', maxZoom: 19,
    }).addTo(map);

    const accent = () => cssVar('--accent') || '#EDEAE3';
    const bounds: L.LatLngExpression[] = [];
    let line: L.Polyline | null = null;
    let glow: L.Polyline | null = null;
    const pts: [number, number][] = route.map((r: any) => [r.lat, r.lng]);

    if (pts.length > 1) {
      glow = L.polyline(pts, { color: accent(), weight: 7, opacity: 0.12 }).addTo(map);
      line = L.polyline(pts, { color: accent(), weight: 1.6, dashArray: '3 7', opacity: 0.9 }).addTo(map);
      pts.forEach((p) => bounds.push(p));
      if (animate && !reduced) {
        let i = 1; line.setLatLngs([pts[0]]); glow.setLatLngs([pts[0]]);
        const step = () => { if (i >= pts.length) return; line!.setLatLngs(pts.slice(0, i + 1)); glow!.setLatLngs(pts.slice(0, i + 1)); i++; setTimeout(step, 260); };
        const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { step(); io.disconnect(); } }, { threshold: 0.3 });
        io.observe(el);
      }
    }

    const byName = new Map<string, L.Marker>();
    markers.forEach((m: any) => {
      const kind = m.kind || 'lugar';
      const icon = L.divIcon({ html: `<div class="pin ${kind === 'base' ? 'base' : kind === 'trabalho' ? 'trabalho' : ''}"></div>`, className: '', iconSize: [14, 14], iconAnchor: [7, 7] });
      const mk = L.marker([m.lat, m.lng], { icon, title: m.name }).addTo(map);
      if (m.label) mk.bindTooltip(m.label, { permanent: true, direction: 'right', offset: [12, 0], className: 'pin-label' });
      mk.bindPopup(`<span class="tc">${m.chapter ? m.chapter + ' · ' : ''}${kind}</span><strong>${m.name}</strong>${m.blurb ? `<br><span>${m.blurb}</span>` : ''}<br><a href="${m.href || mapsUrl(m.name)}" target="_blank" rel="noopener">abrir no Google Maps ↗</a>`);
      mk.on('mouseover', () => { if (hud) { hud.textContent = m.name; hud.classList.add('on'); } });
      mk.on('mouseout', () => hud?.classList.remove('on'));
      byName.set(m.name, mk);
      if (m.slug) byName.set(m.slug, mk);
      bounds.push([m.lat, m.lng]);
    });

    const home = () => { if (fit && bounds.length > 1) map.flyToBounds(L.latLngBounds(bounds), { padding: [40, 40], duration: 1.2 }); else map.flyTo([center.lat, center.lng], center.zoom, { duration: 1.2 }); };
    if (fit && bounds.length > 1) map.fitBounds(L.latLngBounds(bounds), { padding: [40, 40] });

    map.on('click', () => map.scrollWheelZoom.enable());
    map.on('mouseout', () => map.scrollWheelZoom.disable());

    // viajante percorrendo a rota
    let playing = false; let raf = 0; let traveler: L.Marker | null = null;
    const playBtn = el.querySelector<HTMLButtonElement>('[data-play]');
    const stop = () => { playing = false; cancelAnimationFrame(raf); if (playBtn) { playBtn.textContent = '▶ percorrer a rota'; playBtn.classList.remove('on'); } hud?.classList.remove('on'); if (traveler) { map.removeLayer(traveler); traveler = null; } };
    const play = () => {
      if (pts.length < 2) return;
      playing = true; playBtn!.textContent = '■ parar'; playBtn!.classList.add('on');
      line?.setLatLngs(pts); glow?.setLatLngs(pts);
      const icon = L.divIcon({ html: '<div class="traveler"></div>', className: '', iconSize: [10, 10], iconAnchor: [5, 5] });
      traveler = L.marker(pts[0], { icon, interactive: false, zIndexOffset: 1000 }).addTo(map);
      const segDur = reduced ? 1 : 1600; let seg = 0; let t0 = performance.now();
      const nameAt = (i: number) => route[i]?.name || '';
      const frame = (now: number) => {
        if (!playing) return;
        const k = Math.min(1, (now - t0) / segDur);
        const a = pts[seg], b = pts[seg + 1];
        const e = k < 0.5 ? 2 * k * k : -1 + (4 - 2 * k) * k; // easeInOut
        const cur: [number, number] = [a[0] + (b[0] - a[0]) * e, a[1] + (b[1] - a[1]) * e];
        traveler!.setLatLng(cur);
        if (hud) { hud.textContent = `${nameAt(seg)} → ${nameAt(seg + 1)}`; hud.classList.add('on'); }
        if (k >= 1) {
          seg++; t0 = now + 350;
          if (seg >= pts.length - 1) { if (hud) hud.textContent = `${nameAt(pts.length - 1)} · fim da rota`; setTimeout(stop, 1400); return; }
          map.panTo(pts[seg + 1], { animate: true, duration: 1.2, easeLinearity: 0.3 });
        }
        raf = requestAnimationFrame(frame);
      };
      map.flyTo(pts[0], Math.max(map.getZoom(), 4), { duration: 0.8 });
      setTimeout(() => { t0 = performance.now(); raf = requestAnimationFrame(frame); }, 850);
    };
    playBtn?.addEventListener('click', () => (playing ? stop() : play()));

    // atalhos: voar até uma parada
    el.querySelectorAll<HTMLButtonElement>('[data-stop]').forEach((b) => {
      b.addEventListener('click', () => {
        stop();
        el.querySelectorAll('[data-stop]').forEach((x) => x.classList.remove('on')); b.classList.add('on');
        map.flyTo([Number(b.dataset.lat), Number(b.dataset.lng)], Number(b.dataset.zoom), { duration: 1.4 });
        const mk = byName.get(b.dataset.slug || '') || byName.get(b.textContent?.trim() || '');
        if (mk) setTimeout(() => mk.openPopup(), 1500);
      });
    });
    el.querySelector('[data-reset]')?.addEventListener('click', () => { stop(); el.querySelectorAll('[data-stop]').forEach((x) => x.classList.remove('on')); map.closePopup(); home(); });

    // sincronia externa: qualquer elemento com data-map-focus="<nome ou slug>" destaca o pino ao passar o mouse
    document.querySelectorAll<HTMLElement>(`[data-map-for="${el.id}"][data-map-focus]`).forEach((src) => {
      const key = src.dataset.mapFocus || '';
      const mk = byName.get(key);
      if (!mk) return;
      const pin = () => mk.getElement()?.querySelector('.pin');
      src.addEventListener('mouseenter', () => { pin()?.classList.add('hot'); if (hud) { hud.textContent = key; hud.classList.add('on'); } });
      src.addEventListener('mouseleave', () => { pin()?.classList.remove('hot'); hud?.classList.remove('on'); });
    });

    // troca de tema: recolorir a linha
    new MutationObserver(() => { const c = accent(); line?.setStyle({ color: c }); glow?.setStyle({ color: c }); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  });
</script>
