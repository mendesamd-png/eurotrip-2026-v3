---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/cinema.css';
import { planePath } from '../data/plane';
import { chapters } from '../data/trip';
import PhotoGallery from '../components/PhotoGallery.astro';
import GalleryControls from '../components/GalleryControls.astro';
import { galleries } from '../data/galleries';
import StoryText from '../components/StoryText.astro';
import { images, unsplash } from '../data/images';
import { u } from '../data/url';
const destinations = chapters.filter(c => c.slug !== 'partida');
const sceneNames = ['O começo', 'A travessia', ...destinations.map(c => c.title), 'Nós dois', 'Continua'];
const headlines = [['A cidade segue.', 'A gente chega.'], ['Uma pausa.', 'Um amigo.'], ['Um sonho.', 'Old Trafford.'], ['A arte encontra', 'o caminho.'], ['Do concreto', 'às nuvens.'], ['Mais ao norte.', 'Mais devagar.']];
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Uma viagem, seis capítulos · Eurotrip 2026</title>
  <meta name="description" content="O diário de Douglas e Hugo. Entre a Inglaterra, o País Basco e a Madeira, um convite para família e amigos acompanharem o caminho." />
  <link rel="canonical" href={new URL(u('/'), Astro.site)} /><link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <meta name="theme-color" content="#090909" /><meta property="og:title" content="Eurotrip 2026 · Vem com a gente." />
  <meta property="og:description" content="Douglas e Hugo. Seis capítulos entre a Inglaterra, o País Basco e a Madeira." />
  <meta property="og:image" content={unsplash(images.areeiro,1200)} /><meta property="og:type" content="website" /><meta property="og:locale" content="pt_BR" />
  <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
</head>
<body>
  <a class="skip-link" href={u('/diario')}>Ir direto ao diário</a>
  <header class="film-header"><div class="film-brand"><a class="wordmark" href={u('/')} aria-label="Eurotrip 2026, início">EUROTRIP<span>26</span><i></i></a><span class="film-timecode mono" data-countdown-tc role="timer" aria-live="off" aria-label="Contagem para o embarque" title="Dias : horas : minutos : segundos : quadros, a 24 fps">TC -00:00:00:00:00</span></div><span class="header-note mono">UM DIÁRIO DE DOUGLAS & HUGO</span><nav aria-label="Navegação principal"><a href={u('/diario')}>Ler o diário <span>↗</span></a><button id="open-chapters" aria-haspopup="dialog">Capítulos <span aria-hidden="true">☰</span></button></nav></header>
  <main id="film" aria-label="Apresentação da viagem"><div class="film-stage">
    <section class="scene scene-intro is-active" data-scene="0" aria-label="O começo">
      <div class="scene-image intro-image"><img src={unsplash(images.areeiro,2200,85)} alt={images.areeiro.alt} fetchpriority="high" width="2200" height="1467" /></div><div class="image-shade"></div>
      <div class="intro-top mono"><div class="intro-countdown"><span>BRASIL → EUROPA · ATÉ O EMBARQUE</span><span class="intro-timecode" data-countdown-tc role="timer" aria-live="off" aria-label="Dias, horas, minutos, segundos e quadros até o embarque">TC -00:00:00:00:00</span><span class="countdown-key">DD : HH : MM : SS : FF · 24 FPS</span></div><span>OUT / NOV<br/>2026</span></div>
      <div class="intro-title"><p class="eyebrow">DE CASA PARA O MUNDO. E DE VOLTA PARA VOCÊS.</p><h1>Uma viagem.<br/><span>Seis capítulos.</span></h1></div>
      <div class="intro-bottom"><p>Futebol, cinema, arte e um respiro na natureza. <br/>Douglas e Hugo. E vocês, do outro lado da história.</p><button class="round-arrow" data-go="1" aria-label="Começar a travessia">↓</button></div>
      <span class="photo-note mono">MADEIRA · IMAGEM DE REFERÊNCIA</span>
    </section>
    <section class="scene scene-route" data-scene="1" aria-label="A travessia">
      <div class="route-heading"><p class="eyebrow">01 / A TRAVESSIA</p><h2>Um oceano.<br/>Tantos caminhos.</h2><p>Da Inglaterra ao País Basco.<br/>Depois, a ilha. E um pouco menos de pressa.</p><a class="text-link" href={u('/jornada')}>Abrir o mapa e as datas <span>↗</span></a></div>
      <div class="route-diagram"><svg viewBox="0 0 750 630" role="img" aria-labelledby="route-title route-desc"><title id="route-title">Os seis destinos da viagem</title><desc id="route-desc">Esquema sem escala: Londres, Birmingham, Manchester, San Sebastián, Funchal e Ponta Delgada, na Madeira.</desc>
      <defs><pattern id="grid" width="38" height="38" patternUnits="userSpaceOnUse"><path d="M38 0 L0 0 0 38" fill="none" stroke="currentColor" stroke-opacity=".09"/></pattern></defs><rect width="750" height="630" fill="url(#grid)"/>
      <path class="route-ghost" d="M80 552 C100 380 560 400 560 235 L482 163 L420 85 C240 105 270 310 402 360 C435 480 175 605 205 487 L153 443"/>
      <path id="route-draw" pathLength="1" d="M80 552 C100 380 560 400 560 235 L482 163 L420 85 C240 105 270 310 402 360 C435 480 175 605 205 487 L153 443"/>
      <g id="route-plane" transform="translate(80 552) rotate(0)" aria-hidden="true"><path d={planePath}/></g>
      <g><circle cx="80" cy="552" r="4"/><text x="65" y="584">DE SÃO PAULO</text></g><g><circle cx="560" cy="235" r="6"/><text x="581" y="240">01 LONDRES</text></g><g><circle cx="482" cy="163" r="6"/><text x="500" y="163">02 BIRMINGHAM</text></g><g><circle cx="420" cy="85" r="6"/><text x="442" y="89">03 MANCHESTER</text></g><g><circle cx="402" cy="360" r="6"/><text x="426" y="365">04 SAN SEBASTIÁN</text></g><g><circle cx="205" cy="487" r="6"/><text x="226" y="494">05 FUNCHAL</text></g><g><circle cx="153" cy="443" r="6"/><text x="37" y="409">06 PONTA DELGADA</text></g></svg><p class="mono map-caption">UM DESENHO DO PERCURSO · SEM ESCALA</p></div>
      <div class="route-foot mono"><span>6 BASES</span><span>INGLATERRA · PAÍS BASCO · MADEIRA</span><span>OUT / NOV 2026</span></div>
    </section>
    {destinations.map((c,i)=>(<section class:list={['scene','scene-destination',`destination-${c.slug}`,{'scene-framed':i===1||i===3}]} data-scene={i+2} aria-label={c.title}>
      <div class="destination-number" aria-hidden="true">{c.number}</div><PhotoGallery id={`film-${c.slug}`} keys={galleries[c.slug]} name={c.title} cinema /><div class="image-shade"></div>
      <div class="destination-heading"><p class="eyebrow">CAPÍTULO {c.number} / {c.country.toUpperCase()}</p><h2>{c.title==='San Sebastián'?<>San<br/>Sebastián.</>:c.title==='Ponta Delgada'?<>Ponta<br/>Delgada.</>:<>{c.title}.</>}</h2></div>
      <div class="destination-story"><div class="gallery-toolbar"><span class="mono destination-dates">{c.dates} · 2026</span><GalleryControls id={`film-${c.slug}`} count={galleries[c.slug].length} name={c.title} /></div><h3>{headlines[i][0]}<br/>{headlines[i][1]}</h3><p class="reading-hint mono" id={`reading-hint-${c.slug}`}>Role o texto para ler o capítulo ↓</p><div class="reading-window destination-reading" tabindex="0" role="region" aria-label={`História de ${c.title}`} aria-describedby={`reading-hint-${c.slug}`}><p class="story-lead">{c.lead}</p><StoryText slug={c.slug} compact /></div><a class="text-link" href={u(`/capitulo/${c.slug}`)}>Ler este capítulo <span>↗</span></a></div>
      <span class="destination-place mono">{c.slug==='ponta-delgada'?'COSTA NORTE DA MADEIRA':c.country}</span>
    </section>))}
    <section class="scene scene-crew" data-scene="8" aria-label="Nós dois"><div class="crew-heading"><p class="eyebrow">08 / QUEM ESTÁ DO OUTRO LADO</p><h2>Dois amigos.<br/>Um mesmo<br/><span>caminho.</span></h2><p>Dois amigos, dois olhares e assunto para o caminho inteiro. Do set à arquibancada, a gente quer dividir tudo com vocês.</p><a class="text-link" href={u('/tripulacao')}>Conhecer a tripulação <span>↗</span></a></div><figure class="crew-photo crew-douglas"><img src={u('/images/crew/douglas.jpg')} alt="Douglas Mendes" loading="lazy" width="600" height="800"/><figcaption>Douglas Mendes<span class="mono">FOTOGRAFIA</span></figcaption></figure><figure class="crew-photo crew-hugo"><img src={u('/images/crew/hugo.png')} alt="Hugo Lima" loading="lazy" width="600" height="800"/><figcaption>Hugo Lima<span class="mono">DIREÇÃO</span></figcaption></figure></section>
    <section class="scene scene-end" data-scene="9" aria-label="Continua"><div class="scene-image end-image"><img src={unsplash(images.areeiroEstrada,2000,80)} alt={images.areeiroEstrada.alt} loading="lazy" width="2000" height="1333"/></div><div class="image-shade"></div><div class="end-content"><p class="eyebrow">O ROTEIRO ESTÁ ESCRITO. A HISTÓRIA COMEÇA AGORA.</p><h2>Vem com<br/><span>a gente.</span></h2><p>Este é o nosso lugar para dividir o caminho<br/>com quem ficou por perto, mesmo de longe.</p><div class="end-links"><a class="pill-link" href={u('/diario')}>Entrar no diário <span>↗</span></a><a class="text-link" href={u('/podcast')}>Nosso podcast <span>↗</span></a></div><p class="departure mono" id="departure">EMBARQUE · 16 DE OUTUBRO DE 2026</p></div><button class="restart mono" data-go="0">↺ REVER A ABERTURA</button><a class="end-credits mono" href={u('/colophon')}>IMAGENS & CRÉDITOS ↗</a></section>
  </div></main>
  <aside class="film-transport" aria-label="Controles da apresentação"><span class="transport-label mono"><span id="scene-index">00</span><span class="transport-dash"></span><span id="scene-name">O começo</span></span><span class="scroll-cue mono">ROLE PARA EXPLORAR ↓</span><div class="transport-buttons"><button data-step="-1" aria-label="Cena anterior">↑</button><button data-step="1" aria-label="Próxima cena">↓</button></div></aside>
  <nav class="scene-rail" aria-label="Cenas da abertura">{sceneNames.map((name,i)=><button data-go={i} aria-label={`Cena ${i}: ${name}`} aria-current={i===0?'step':undefined}><span></span></button>)}</nav><div class="film-progress" aria-hidden="true"><span id="film-progress"></span></div><span class="film-cursor" aria-hidden="true"></span>
  <dialog id="chapters-dialog" aria-labelledby="chapters-title"><div class="dialog-top"><span class="mono">EUROTRIP 2026 / ÍNDICE</span><button id="close-chapters" autofocus aria-label="Fechar capítulos">Fechar ✕</button></div><h2 id="chapters-title">Escolha um caminho.</h2><div class="chapter-list">{chapters.map(c=><a href={u(`/capitulo/${c.slug}`)}><span class="mono">{c.number}</span><span>{c.title}</span><span class="mono chapter-date">{c.dates}</span><span aria-hidden="true">↗</span></a>)}</div><nav class="dialog-links" aria-label="Mais sobre a viagem"><a href={u('/diario')}>Diário completo ↗</a><a href={u('/jornada')}>Mapa e datas ↗</a><a href={u('/futebol')}>Futebol & Ted Lasso ↗</a><a href={u('/trabalhos')}>Os dois trabalhos ↗</a><a href={u('/podcast')}>Podcast ↗</a><a href={u('/tripulacao')}>Tripulação ↗</a><a href={u('/kit')}>O kit ↗</a><a href={u('/bordo')}>Bordo privado ↗</a><a href={u('/colophon')}>Créditos ↗</a></nav></dialog>
  <noscript><style>.film-stage{position:relative;height:auto}.scene{position:relative;min-height:100svh;opacity:1!important;visibility:visible!important;pointer-events:auto!important}.film-transport,.scene-rail,.film-cursor{display:none}#film{height:auto}.film-header{position:relative}</style></noscript>
  <script src="../scripts/countdown.ts"></script>
  <script src="../scripts/cinema.ts"></script>
</body></html>
