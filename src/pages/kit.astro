---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../data/url';
import '../styles/editorial.css';
const kit = [
 ['01','Sony FX3','Cinema','Para as histórias que pedem uma diária de filmagem: entrevistas, gestos, espaços e tempo para observar.'],
 ['02','Sony A7V','Foto + vídeo','Um segundo olhar para acompanhar o trabalho e guardar o que acontece entre uma cena e outra.'],
 ['03','Sony GM 24–70mm','O espaço e o detalhe','A lente para mudar de enquadramento quando o mundo continua andando e a gente quer acompanhar.'],
 ['04','Sony GM 70–200mm','Olhar de longe','Para descobrir detalhes à distância e deixar uma cena respirar sem chegar tão perto.'],
 ['05','Sony FE 50mm f/1.2 GM','Pessoas e presença','Para os momentos em que vale demorar um pouco mais num rosto, num gesto, numa pequena descoberta.'],
 ['06','Insta360 Ace Pro 2','O caminho também conta','Continua na viagem: movimento, bastidores e aquele pedaço de caminhada que dá vontade de dividir.'],
];
const hugo=['Sony A7V','iPhone 17 Pro Max · 512 GB','Sony FE 50mm f/1.2 GM','Monitor Viltrox','3 baterias Sony','SD Lexar · 320 GB','LED quadrado · 40 W','Hollyland Lark M2S'];
---
<BaseLayout title="O kit" description="Sony FX3, A7V, três lentes G Master, Insta360 e a lista de equipamentos do Hugo." current={u('/kit')}>
 <header class="wrap editorial-intro"><p class="tc">O que vai na mochila</p><h1 class="t-hero">O que vai<br/>com a gente.</h1><p class="t-lead">Câmeras, lentes, som e luz para os dois trabalhos. E, entre as diárias, para os detalhes da viagem que a gente quer trazer para vocês. A mochila leva bastante coisa. A curiosidade vai do lado de fora.</p></header>
 <section class="wrap"><ol class="kit-list">{kit.map(([n,name,cat,text])=><li><span class="tc">{n} / {cat}</span><div><h2 class="t-l">{name}</h2><p>{text}</p></div></li>)}</ol></section>
 <section class="wrap section editorial-grid"><div><p class="tc">Lista enviada pelo Hugo</p><h2 class="t-xl" style="margin-top:1rem">A parte dele<br/>da bagagem.</h2><p class="t-lead" style="margin-top:1.4rem">Da A7V ao microfone, o conjunto que Hugo está preparando para os dias de trabalho e os bastidores.</p><p class="editorial-aside">A A7V e a 50mm aparecem também no conjunto acima. A lista detalha os equipamentos do conjunto que ficarão com Hugo.</p></div><ul class="editorial-list">{hugo.map(item=><li>{item}</li>)}</ul></section>
 <section class="wrap editorial-callout"><p class="tc">Entre uma diária e outra</p><h2 class="t-l">Carregar, conferir, guardar.</h2><p class="t-lead" style="max-width:55ch">O fim do dia também tem bastidores: conferir o material, organizar as cópias e preparar tudo para a próxima saída. Cabos, carregadores, adaptadores e os demais acessórios ainda entram na lista final.</p><p class="editorial-source">Lista em preparação, conforme os equipamentos informados por Douglas e Hugo. Modelo do monitor, geração dos zooms e capacidade/modelo do cartão Lexar ficam para a conferência final do kit.</p><div class="editorial-links"><a class="btn" href={u('/trabalhos')}>Conhecer os dois trabalhos ↗</a><a class="lnk" href={u('/podcast')}>Ouvir a história da viagem ↗</a></div></section>
</BaseLayout>
<style>.kit-list li{display:grid;gap:1rem;border-top:1px solid var(--line);padding-block:2.3rem}.kit-list p{max-width:53ch;margin-top:1rem;color:var(--text-2)}@media(min-width:800px){.kit-list li{grid-template-columns:1fr 3fr;gap:3rem}}</style>
